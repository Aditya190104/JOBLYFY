# Run python scripts/configure_env.py to create .env with a unique secret.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Use complete https:// origins, comma separated, for your deployed domain.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional absolute paths; leave commented for the project defaults.
# DJANGO_DB_PATH=
# DJANGO_MEDIA_ROOT=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=JOBLYFY <noreply@localhost>
# DEBUG=False enables HTTPS redirect, secure cookies and HSTS by default.

# Only behind a trusted HTTPS reverse proxy that sets/strips this header itself.
# DJANGO_TRUST_PROXY_HTTPS=False
# Database sessions: browser-length by default; Remember me lasts 14 days.
# Keep .env, db.sqlite3 and media/ across upgrades and restarts.
