    "manage.py migrate --check",
    "-c \nimport os, json, secrets\nos.environ.setdefault('DJANGO_SETTINGS_MODULE','core.settings')\nimport django; django.setup()\nfrom django.test import Client\nfrom django.test.utils import setup_test_environment\nfrom django.template.loader import get_template\nfrom pathlib import Path\nfrom apps.jobs.models import Job\nsetup_test_environment()\nc=Client(HTTP_HOST='localhost')\npaths=['/','/jobs/','/companies/','/categories/','/accounts/login/','/accounts/signup/','/accounts/password_reset/','/about/']\nfor path in paths: assert c.get(path).status_code==200, path\nassert Job.objects.open().count()==18\nfor job in Job.objects.open(): assert c.get(job.get_absolute_url()).status_code==200\nassert c.get('/jobs/?search=Python').context['page_obj'].paginator.count>0\nassert c.get('/jobs/?search=not-a-real-test-role').context['page_obj'].paginator.count==0\nfor path in Path('templates').rglob('*.html'): get_template(str(path.relative_to('templates')))\npassword='  Check-'+secrets.token_hex(16)+'!  '\nr=c.post('/accounts/signup/jobseeker/',{'username':'package-check-user','email':'package-check@example.invalid','password1':password,'password2':password})\nassert r.status_code==302\nassert c.get('/dashboard/jobseeker/').status_code==200\nc.post('/accounts/logout/')\nr=c.post('/accounts/login/',{'username_or_email':'PACKAGE-CHECK-USER','password':password})\nassert r.status_code==302\nj=Job.objects.open().first()\nr=c.post(f'/jobs/{j.pk}/save/',{'intent':'save'},HTTP_ACCEPT='application/json')\nassert r.status_code==200 and r.json()['saved']\nassert c.get('/dashboard/saved/').status_code==200\nprint(json.dumps({'public_routes':len(paths),'job_details':18,'templates':len(list(Path('templates').rglob('*.html'))),'signup_login_save':'passed'}))\n",
    "manage.py migrate --noinput",
    "manage.py createcachetable",
    "manage.py seed_categories",
    "manage.py seed_demo_jobs",
    "manage.py seed_demo_jobs",
    "manage.py check",
    "-c \nimport os, json\nos.environ.setdefault('DJANGO_SETTINGS_MODULE','core.settings')\nimport django; django.setup()\nfrom apps.accounts.models import CustomUser\nfrom apps.jobs.models import Job,EligibilityRule,ScreeningQuestion,Application\nvalue={'users':CustomUser.objects.count(),'open_jobs':Job.objects.open().count(),'rules':EligibilityRule.objects.count(),'questions':ScreeningQuestion.objects.count(),'applications':Application.objects.count()}\nassert value=={'users':4,'open_jobs':18,'rules':87,'questions':72,'applications':0},value\nprint(json.dumps(value))\n"
  ],
